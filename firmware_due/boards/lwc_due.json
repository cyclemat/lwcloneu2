{
  "build": {
    "arduino": {
      "ldscript": "flash.ld"
    },
    "core": "arduino",
    "cpu": "cortex-m3",
    "extra_flags": "-D__SAM3X8E__ -DARDUINO_SAM_DUE",
    "f_cpu": "84000000L",
    "hwids": [
      [
        "0xFAFA",
        "0x00F0"
      ]
    ],
    "mcu": "at91sam3x8e",
    "usb_product": "LWCloneU2 v2 (Due)",
    "variant": "arduino_due_x"
  },
  "debug": {
    "jlink_device": "ATSAM3X8E",
    "openocd_chipname": "at91sam3X8E",
    "openocd_target": "at91sam3ax_8x",
    "svd_path": "ATSAM3X8E.svd"
  },
  "frameworks": [
    "arduino"
  ],
  "name": "Arduino Due als LWCloneU2 (USB Native Port)",
  "upload": {
    "disable_flushing": true,
    "maximum_ram_size": 98304,
    "maximum_size": 524288,
    "native_usb": true,
    "offset_address": "0x80000",
    "protocol": "sam-ba",
    "protocols": [
      "sam-ba",
      "jlink",
      "blackmagic",
      "atmel-ice",
      "stlink"
    ],
    "require_upload_port": true,
    "use_1200bps_touch": true,
    "wait_for_upload_port": true
  },
  "url": "https://github.com/cyclemat/lwcloneu2",
  "vendor": "LWCloneU2"
}
